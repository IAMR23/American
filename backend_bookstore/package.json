{
  "name": "book-store-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API base de BOOK STORE",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check": "node --check src/server.js && node --check src/app.js",
    "create-admin": "node src/scripts/create-admin.js",
    "seed": "node src/scripts/seed-catalog.js",
    "test": "node --test --test-concurrency=1 src/tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.18.1",
    "morgan": "^1.10.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.7",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  }
}
